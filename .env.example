# Cardano Raw SDK Demeter POC
# Copy to .env.development. Never commit credentials or mnemonics.

PORT=8000
NODE_ENV=production
SERVER_HOST=127.0.0.1
# Required only when starting the REST server; use at least 32 random bytes.
# Generate one with: openssl rand -hex 32
SERVER_API_KEY=
REQUEST_BODY_LIMIT=256kb
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100
# Set only when a trusted reverse proxy terminates TLS and overwrites forwarding headers.
TRUST_PROXY=false
CARDANO_NETWORK=Preview
CHAIN_PROVIDER=demeter
CUSTODY_MODE=mock

# Demeter Blockfrost extension (required for either POC mode)
DEMETER_BLOCKFROST_URL=https://cardano-preview.blockfrost-m1.demeter.run
DEMETER_API_KEY=

# Existing IAGON provider remains available when CHAIN_PROVIDER=iagon
IAGON_API_KEY=

# Mock custody: live reads and local witness verification; never broadcasts
CARDANO_MNEMONIC=
CARDANO_ADDRESS_1=addr_test1...
CARDANO_ADDRESS_2=addr_test1...

# Fireblocks custody: provide one secret-key form and explicitly authorize broadcast
FIREBLOCKS_API_USER_KEY=
FIREBLOCKS_API_USER_SECRET_KEY_PATH=
FIREBLOCKS_API_USER_SECRET_KEY=
FIREBLOCKS_BASE_PATH=https://api.fireblocks.io
FIREBLOCKS_VAULT_ACCOUNT_ID=
RUN_LIVE_FIREBLOCKS=0

# The live runner is restricted to Preview; 2 ADA by default.
LIVE_TRANSFER_LOVELACE=2000000
